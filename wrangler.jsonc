{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pharmacy-pos",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "build": { "command": "node scripts/build-worker-static.mjs" },
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "PharmacyStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PharmacyStore"] }],
  "vars": {
    "COOKIE_SECURE": "1",
    "CLIENT_IP_HEADER": "x-client-ip",
    "UTC_OFFSET_MINUTES": "300"
  },
  // SETUP_TOKEN is a secret: npx wrangler secret put SETUP_TOKEN
  "routes": [{ "pattern": "pharmacy.z88.tech", "custom_domain": true }],
  "observability": { "enabled": true }
}
